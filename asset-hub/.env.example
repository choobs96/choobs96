# Copy to .env and fill in what you use. Every key here is read-only.

# Protects the app when it listens beyond this machine (e.g. over Tailscale).
APP_PASSCODE=
PORT=8787
# How often to sync IBKR, Binance and wallets, in hours.
SYNC_HOURS=6

# 1. Interactive Brokers: Client Portal → Performance & Reports → Flex Queries
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# 2. Moomoo: token the OpenD bridge script uses to push positions (any long random string)
BRIDGE_TOKEN=

# 6. Binance: API key with ONLY "Enable Reading" ticked
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 7. On-chain wallets: free key from developers.zerion.io (addresses are added in the app)
ZERION_API_KEY=

# Reads PDF statements (Maybank, DBS) and screenshots. Optional.
ANTHROPIC_API_KEY=
